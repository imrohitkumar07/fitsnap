# ─── Secrets ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_secret_here_change_in_production

# ─── Database ──────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Server ────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Client (Vite prefix) ─────────────────────
VITE_API_URL=http://localhost:3001/api
